# Copy this file to .env.local or set the variable in the process environment.
DEEPSEEK_API_KEY=
SONIOX_API_KEY=
# Local livekit-server --dev credentials, also needed by this SDK console setup.
# Text mode does not require these settings. Replace them for other servers.
LIVEKIT_URL=ws://localhost:7880
# Browser-facing address; override when it differs from the backend server address.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
